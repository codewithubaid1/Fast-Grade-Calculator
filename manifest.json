{
  "manifest_version": 3,
  "name": "Grade Calculaotr",
  "version": "1.0",
  "description": "Grade Calcuator by ubaidullah.",
  "permissions": [],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/*",
        "http://flexstudent.nu.edu.pk/*",
        "https://flex.nu.edu.pk/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}